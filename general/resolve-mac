#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ||  "$1" == '-h' || "$1" == '--help' ]]; then
	printf "Usage: ${0##*/} [-h] <ip>\n"
	printf "Resolve an IP address to a MAC address using ip neigh.\n"	
	exit 0
fi


ip="$1"
mac=$(ip neigh show "$ip" 2>/dev/null | awk '/lladdr/ {print $5; exit}')

if [[ -z $mac ]]; then
	printf '%s: error: could not resolve MAC address for "%s"\n' "${0##*/}" "$ip" >&2
	exit 1
fi

printf '%s\n' "$mac"
